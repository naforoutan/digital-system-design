transcript on

# recreate work library
if {[file exists work]} {
    vdel -lib work -all
}
vlib work
vmap work work

# compile DES components
vlog E.v
vlog P.v
vlog S1.v
vlog S2.v
vlog S3.v
vlog S4.v
vlog S5.v
vlog S6.v
vlog S7.v
vlog S8.v
vlog IP.v
vlog IP_inv.v
vlog PC1.v
vlog PC2.v

# compile DES core
vlog main.v

# compile triple DES (multi-cycle version)
vlog triple_des_multi_cycle.v

# compile testbench
vlog tb_triple_des_multi_cycle.v

# start simulation
vsim -voptargs=+acc work.tb_triple_des_multi_cycle

# add selected waves
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/clk
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/nrst
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/start
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/mode
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/key
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/iv

# DUT 256 signals
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/dut_256/busy
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/dut_256/done
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/dut_256/state
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/dut_256/index
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/dut_256/data_in
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/dut_256/data_out

# DUT 300 signals
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/dut_300/busy
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/dut_300/done
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/dut_300/state
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/dut_300/index
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/dut_300/data_in
add wave -position insertpoint sim:/tb_triple_des_multi_cycle/dut_300/data_out

# run simulation
run -all
